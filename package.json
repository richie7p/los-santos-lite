{
  "name": "port-solara-streets",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "索拉港街頭 Port Solara Streets — 瀏覽器 3D 開放世界犯罪動作沙盒：飆車、槍戰、警察追緝、主線任務與街頭賽車",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8080",
    "build": "tsc --noEmit && vitest run && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.510.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "three": "^0.175.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.175.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "^5.8.2",
    "vite": "^6.3.0",
    "vitest": "^3.2.4"
  }
}
